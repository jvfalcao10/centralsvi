{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "datas-svi.svicompany.com.br"
        }
      ],
      "destination": "https://central.svicompany.com.br/content/datas",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "inteligencia.svicompany.com.br"
        }
      ],
      "destination": "https://central.svicompany.com.br/inteligencia",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/aprovar/cliente/:token/preview.jpg",
      "destination": "/api/r?__rota=social-share&bundle=1&token=:token&image=1"
    },
    {
      "source": "/aprovar/cliente/:token",
      "destination": "/api/r?__rota=social-share&bundle=1&token=:token"
    },
    {
      "source": "/aprovar/social/:token/preview.jpg",
      "destination": "/api/r?__rota=social-share&token=:token&image=1"
    },
    {
      "source": "/aprovar/social/:token",
      "destination": "/api/r?__rota=social-share&token=:token"
    },
    {
      "source": "/api/social",
      "destination": "/api/r?__rota=social"
    },
    {
      "source": "/equipe",
      "destination": "/api/r?__rota=equipe-dia"
    },
    {
      "source": "/api/radar-trends",
      "destination": "/api/r?__rota=radar-trends"
    },
    {
      "source": "/api/radar-coletar",
      "destination": "/api/r?__rota=radar-coletar"
    },
    {
      "source": "/api/aprovar-conteudo",
      "destination": "/api/r?__rota=aprovar-conteudo"
    },
    {
      "source": "/api/vaga-trafego",
      "destination": "/api/r?__rota=vaga-trafego"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/interno/:file(.*\\.html)",
      "destination": "/interno/:file"
    },
    {
      "source": "/r/trafego/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/aprovar/conteudo/:token",
      "destination": "/index.html"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/r?slug=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/radar-trends",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/radar-coletar",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/aprovar/cliente/:path*",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Referrer-Policy", "value": "no-referrer"}
      ]
    },
    {
      "source": "/aprovar/social/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/r.ts": {
      "includeFiles": "dist/index.html",
      "maxDuration": 300
    }
  }
}
